# firmware / images / archives — never commit binaries
*.zip
# ...but small module packages under modules/ are wanted in git
!modules/**/*.zip
!modules/**/*.apk
*.7z
*.tgz
*.img
*.elf
*.melf
*.apk
*.tar
*.xz

# downloads & segments
firmware/
segs/
*.segs/

# working artifacts
*.png
*.log
_venv/
__pycache__/
