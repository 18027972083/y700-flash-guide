# firmware / images / archives — never commit binaries
*.zip
# ...but small module packages under modules/ are wanted in git
!modules/**/*.zip
*.7z
*.tgz
*.img
*.elf
*.melf
*.apk
*.tar
*.xz

# downloads & segments
firmware/
segs/
*.segs/

# working artifacts
*.png
*.log
_venv/
__pycache__/

# module packages built from source (build.sh) — kept in git for direct download;
# must be the LAST rules so they override the *.zip / *.apk ignores above
!modules/**/*.zip
!modules/**/*.apk
